DJANGO_SECRET_KEY=replace-with-a-local-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tu-backend.vercel.app

# Usa los datos de conexión del proyecto Supabase. Nunca subas el .env real.
DB_HOST=your-project-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=replace-locally
DB_SSLMODE=require

# SMTP real para entregar códigos 2FA. Sin EMAIL_HOST, el entorno local
# muestra el mensaje en la consola; no lo envía a una bandeja.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=NUAM <no-reply@example.com>



CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tu-front.vercel.app
CSRF_TRUSTED_ORIGINS=https://tu-backend.vercel.app,https://tu-front.vercel.app
FRONTEND_URL=https://tu-front.vercel.app

# Supabase Storage privado
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_reemplazar
# SUPABASE_SERVICE_ROLE_KEY=solo-para-claves-antiguas

# Solo origenes explicitos (CORS_ALLOWED_ORIGINS / FRONTEND_URL). Regex opcional, desactivado por defecto:
# CORS_ALLOWED_ORIGIN_REGEXES=
